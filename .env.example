NODE_ENV=development

WEB_PORT=3000
API_PORT=4000
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Supply the local Neon development-branch connection string in .env.
DATABASE_URL=postgresql://username:password@host/neondb?sslmode=require

# Neon Auth settings for the local development branch.
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
# JWT issuer and audience use the Neon Auth origin, without the /neondb/auth path.
NEON_AUTH_ISSUER=https://your-branch.neonauth.region.aws.neon.tech
NEON_AUTH_AUDIENCE=https://your-branch.neonauth.region.aws.neon.tech
# Use a random value with at least 32 characters. Keep it local.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-32-character-secret
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

REDIS_URL=redis://localhost:6379
RESEARCH_FAKE_URL=http://localhost:4100

GCS_ENDPOINT=http://localhost:4443
GCS_PROJECT_ID=damdai-local
GCS_SOURCE_BUCKET=damdai-source-audio
GCS_ARTIFACT_BUCKET=damdai-artifacts

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Integration tests start a disposable PostgreSQL 18 container; DATABASE_URL is not used.
