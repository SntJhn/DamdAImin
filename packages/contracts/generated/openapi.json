                            "modelVersion",
                            "preprocessingVersion",
                            "ruleSetVersion"
                          ],
                          "properties": {
                            "outcome": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "definitive"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "inconclusive"
                                  ]
                                }
                              ]
                            },
                            "emotionClassification": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "happiness"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "sadness"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "anger"
                                  ]
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "neutrality"
                                  ]
                                }
                              ]
                            },
                            "confidence": {
                              "type": "object",
                              "required": [
                                "happiness",
                                "sadness",
                                "anger",
                                "neutrality"
                              ],
                              "properties": {
                                "happiness": {
                                  "minimum": 0,
                                  "maximum": 1,
                                  "type": "number"
                                },
                                "sadness": {
                                  "minimum": 0,
                                  "maximum": 1,
                                  "type": "number"
                                },
                                "anger": {
                                  "minimum": 0,
                                  "maximum": 1,
                                  "type": "number"
                                },
                                "neutrality": {
                                  "minimum": 0,
                                  "maximum": 1,
                                  "type": "number"
                                }
                              }
                            },
                            "transcript": {
                              "type": "string"
                            },
                            "explanation": {
                              "type": "string"
                            },
                            "technicalTrace": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "cue",
                                  "value"
                                ],
                                "properties": {
                                  "cue": {
                                    "type": "string"
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "contractVersion": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "modelVersion": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "preprocessingVersion": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "ruleSetVersion": {
                              "minLength": 1,
                              "type": "string"
                            }
                          }
