    "/api/v1/analysis-uploads": {
      "post": {
        "summary": "Create a private Source Audio upload operation",
        "tags": [
          "Analyses"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
