          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "analyses"
                  ],
                  "properties": {
                    "analyses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "status",
                          "createdAt"
                        ],
                        "properties": {
                          "id": {
                            "format": "uuid",
