                            {
                              "type": "string",
                              "enum": [
                                "completed"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "failed"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "canceled"
                              ]
                            }
