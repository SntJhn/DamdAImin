                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "processing"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "completed"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "failed"
                                ]
                              }
                            ]
                          },
                          "createdAt": {
                            "format": "date-time",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
